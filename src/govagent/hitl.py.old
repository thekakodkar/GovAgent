from enum import Enum
from typing import Optional, Any, Protocol, List
from pydantic import BaseModel, Field
import uuid

class ApprovalStatus(Enum):
    PENDING = "pending"
    APPROVED = "approved"
    REJECTED = "rejected"
    EXPIRED = "expired"

class ApprovalRequest(BaseModel):
    """A formal request for human intervention with enhanced context."""
    request_id: str = Field(default_factory=lambda: str(uuid.uuid4()))
    agent_id: str
    reason: str 
    # v0.2.3: Track which specific guard triggered this
    triggered_by: str = "judiciary" 
    context: Any 
    status: ApprovalStatus = ApprovalStatus.PENDING
    reviewer_notes: Optional[str] = None

class HITLAdapter(Protocol):
    """Protocol for different notification channels (CLI, Slack, Teams)."""
    async def notify(self, request: ApprovalRequest) -> bool:
        ...

class CLIAdapter:
    """Standard Console Adapter for local development."""
    async def notify(self, request: ApprovalRequest) -> bool:
        print(f"\n--- ⚖️ GOVAGENT JUDICIARY INTERVENTION ---")
        print(f"ID: {request.request_id}")
        print(f"Agent: {request.agent_id}")
        print(f"Triggered By: {request.triggered_by.upper()}")
        print(f"Reason: {request.reason}")
        print(f"Context: {request.context}")
        
        user_input = input("\nDecision (y/n) or add notes: ").strip().lower()
        return user_input.startswith('y')

class HITLManager:
    """
    Orchestrates the Chain of Accountability's 'Judiciary' layer.
    """
    def __init__(self, adapter: Optional[HITLAdapter] = None):
        self.adapter = adapter or CLIAdapter()
        self.history: List[ApprovalRequest] = []

    async def secure_approval(
        self, 
        agent_id: str, 
        reason: str, 
        context: Any, 
        triggered_by: str = "judiciary"
    ) -> bool:
        """
        The entry point for the Executive Loop to request permission.
        v0.2.3: Now accepts 'triggered_by' to identify the specific guard.
        """
        request = ApprovalRequest(
            agent_id=agent_id,
            reason=reason,
            triggered_by=triggered_by,
            context=context
        )
        
        # Block execution until the adapter returns a decision
        is_approved = await self.adapter.notify(request)
        
        request.status = ApprovalStatus.APPROVED if is_approved else ApprovalStatus.REJECTED
        self.history.append(request)
        
        return is_approved